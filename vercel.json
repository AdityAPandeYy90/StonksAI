{
  "rewrites": [
    {
      "source": "/style.css",
      "destination": "/api/index.py"
    },
    {
      "source": "/app.js",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    }
  ]
}
